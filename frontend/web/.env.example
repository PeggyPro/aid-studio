# 开发代理目标（后端地址），与原 Nuxt 项目 NUXT_PROXY_TARGET 语义一致
NEXT_PROXY_TARGET=http://127.0.0.1:8080
# 默认留空：画布复用系统后端和登录。仅旧版明确分开部署时配置独立网关。
NEXT_PUBLIC_CANVAS_API_BASE_URL=
# 仅本地开发。信令上游与桌面站点跨域时填服务端允许的 HTTPS 站点来源（含端口）。
AID_DEV_DIRECTOR_ORIGIN=
# 分镜脚本/视频/配音：0=真实接口（默认），1=本地模拟进度
NEXT_PUBLIC_MOCK_STEP4_PLUS_GEN=0
# 百度搜索资源平台的 HTML 标签验证代码（例如 codeva-xxxxxxxxxx）
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
# 自由画布深度动作捕捉：仅在后端 DEPTH_CAPTURE 联调验收后开启（构建时注入）
NEXT_PUBLIC_STUDIO_DEPTH_CAPTURE_ENABLED=false
# 同一段视频、时长和时间轴对齐的真实原片/深度输出演示；不配置时明确展示当前源视频
NEXT_PUBLIC_STUDIO_DEPTH_DEMO_BEFORE_URL=
NEXT_PUBLIC_STUDIO_DEPTH_DEMO_AFTER_URL=
