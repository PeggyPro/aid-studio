<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aid.media.mapper.AidMediaSubmissionReconciliationMapper">

    <select id="selectByTaskIdForUpdate" resultType="com.aid.media.domain.AidMediaSubmissionReconciliation">
        select *
        from aid_media_submission_reconciliation
        where task_id = #{taskId}
        limit 1
        for update
    </select>

</mapper>
