<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aid.media.mapper.AidMediaSubmissionEvidenceMapper">

    <select id="selectLatestByTaskId" resultType="com.aid.media.domain.AidMediaSubmissionEvidence">
        select *
        from aid_media_submission_evidence
        where task_id = #{taskId}
        order by id desc
        limit 1
    </select>

</mapper>
