    {"type": "SOURCE_EPISODE_MAP", "requiredFields": ["episode", "sourceSpans", "mustKeep", "capacityEstimate"]},
    {"type": "ADAPTATION_BLUEPRINT", "requiredFields": ["approach", "eventLine", "characters", "episodePlan", "derivedChanges"]},
    {"type": "SCREENPLAY_DRAFT", "requiredFields": ["sourceRevision", "sourceSpans", "basePlanRevision", "content", "derivedContent"]},
    {"type": "REVISION_PROPOSAL", "requiredFields": ["baseArtifactRevision", "scope", "impact", "replacementOrPatch"]}
  ],
  "runtimeOwned": ["coverageLedger", "artifactRevision", "acceptance", "checkpointState", "billing", "taskState"]
}

